@HackathonTaskTicketingSystem_HostAddress = http://localhost:5083

### Sign up (then open MailPit at http://localhost:8025 to get the verification link)
POST {{HackathonTaskTicketingSystem_HostAddress}}/auth/signup
Content-Type: application/json

{
  "email": "user@example.com",
  "password": "password123"
}

### Resend verification email
POST {{HackathonTaskTicketingSystem_HostAddress}}/auth/resend
Content-Type: application/json

{
  "email": "user@example.com"
}

### Verify email (paste the token from the MailPit link)
GET {{HackathonTaskTicketingSystem_HostAddress}}/auth/verify-email?token=PASTE_TOKEN_HERE

### Log in (sets the auth cookie)
POST {{HackathonTaskTicketingSystem_HostAddress}}/auth/login
Content-Type: application/json

{
  "email": "user@example.com",
  "password": "password123"
}

### Current user (requires the auth cookie from login)
GET {{HackathonTaskTicketingSystem_HostAddress}}/auth/me

### Log out
POST {{HackathonTaskTicketingSystem_HostAddress}}/auth/logout

### List teams (requires auth cookie)
GET {{HackathonTaskTicketingSystem_HostAddress}}/teams

### Create a team
POST {{HackathonTaskTicketingSystem_HostAddress}}/teams
Content-Type: application/json

{
  "name": "Backend Team"
}

### Rename a team (replace the id)
PUT {{HackathonTaskTicketingSystem_HostAddress}}/teams/00000000-0000-0000-0000-000000000000
Content-Type: application/json

{
  "name": "Platform Team"
}

### Delete a team (replace the id)
DELETE {{HackathonTaskTicketingSystem_HostAddress}}/teams/00000000-0000-0000-0000-000000000000

### List epics (optionally filtered by team)
GET {{HackathonTaskTicketingSystem_HostAddress}}/epics

### Create an epic (replace teamId)
POST {{HackathonTaskTicketingSystem_HostAddress}}/epics
Content-Type: application/json

{
  "teamId": "00000000-0000-0000-0000-000000000000",
  "title": "Checkout revamp",
  "description": "Optional description"
}

### Update an epic (title/description only; team is immutable)
PUT {{HackathonTaskTicketingSystem_HostAddress}}/epics/00000000-0000-0000-0000-000000000000
Content-Type: application/json

{
  "title": "Checkout revamp v2",
  "description": null
}

### Delete an epic (replace the id)
DELETE {{HackathonTaskTicketingSystem_HostAddress}}/epics/00000000-0000-0000-0000-000000000000

### List tickets for a team (optional filters: type, epicId, search)
GET {{HackathonTaskTicketingSystem_HostAddress}}/tickets?teamId=00000000-0000-0000-0000-000000000000

### Create a ticket (state optional, defaults to "new"; epic must be of the same team)
POST {{HackathonTaskTicketingSystem_HostAddress}}/tickets
Content-Type: application/json

{
  "teamId": "00000000-0000-0000-0000-000000000000",
  "epicId": null,
  "type": "bug",
  "state": "new",
  "title": "Login button misaligned",
  "body": "On mobile the login button overlaps the footer."
}

### Update a ticket (type, team, epic, title, body, state)
PUT {{HackathonTaskTicketingSystem_HostAddress}}/tickets/00000000-0000-0000-0000-000000000000
Content-Type: application/json

{
  "teamId": "00000000-0000-0000-0000-000000000000",
  "epicId": null,
  "type": "fix",
  "state": "in_progress",
  "title": "Login button misaligned",
  "body": "Updated description."
}

### Delete a ticket (replace the id)
DELETE {{HackathonTaskTicketingSystem_HostAddress}}/tickets/00000000-0000-0000-0000-000000000000
