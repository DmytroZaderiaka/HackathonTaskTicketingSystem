# Copy this file to `.env` before running `docker compose up --build`.
# Keys + placeholder values only. Never commit a real `.env` with secrets.

# --- PostgreSQL ---
POSTGRES_USER=ticketing
POSTGRES_PASSWORD=local-dev-password
POSTGRES_DB=ticketing

# --- SMTP ---
# Dev/demo uses the bundled MailPit container (see docker-compose.yml); no values
# are needed here for that path. For production, point the API at the real relay:
#   SMTP__Host=relay1.dataart.com
#   SMTP__Port=25
